{
  "name": "magpie-ssh-chat-hf-co",
  "version": "0.1.0",
  "description": "Experimental Magpie/OpenCode provider for Hugging Face SSH chat",
  "type": "module",
  "main": "./index.mjs",
  "exports": { ".": "./index.mjs" },
  "files": ["index.mjs", "src/*.mjs", "src/*.py", "scripts/*.mjs", "README.md", "docs/*.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "probe": "node scripts/probe.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "keywords": ["magpie", "opencode", "opencode-plugin", "huggingface", "ssh"],
  "repository": { "type": "git", "url": "https://github.com/mu-zi-lee/magpie-ssh-chat-hf-co.git" },
  "license": "MIT",
  "engines": { "node": ">=20" },
  "magpie": { "maxConcurrency": 1 },
  "dependencies": { "@xterm/headless": "^5.5.0", "ajv": "^8.17.1" }
}
