{
  "name": "magpie-ssh-chat-hf-co",
  "version": "0.4.0",
  "description": "Experimental Magpie/OpenCode provider for Hugging Face SSH chat",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": ["index.mjs", "src/*.mjs", "scripts/*.mjs", "assets/icon.webp", "README.md", "docs/*.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "login": "node scripts/login.mjs",
    "probe": "node scripts/probe.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "smoke:agent": "node scripts/smoke-agent.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "keywords": ["magpie", "opencode", "opencode-plugin", "huggingface", "ssh"],
  "repository": {
    "type": "git",
    "url": "https://github.com/mu-zi-lee/magpie-ssh-chat-hf-co.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "magpie": {
    "icon": "https://raw.githubusercontent.com/mu-zi-lee/magpie-ssh-chat-hf-co/main/assets/icon.webp",
    "maxConcurrency": 1
  },
  "dependencies": {
    "@xterm/headless": "^5.5.0",
    "ajv": "^8.17.1",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.67",
    "ai": "^7.0.137"
  }
}
